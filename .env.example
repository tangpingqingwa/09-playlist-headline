# Copy to .env.local. Never commit secrets.
# Explicit offline mode; production must use WAFFO_MODE=waffo-prod.
WAFFO_MODE=fixture

# Waffo Pancake MoR. Never set live keys in fixture/test runs.
WAFFO_MERCHANT_ID=
WAFFO_STORE_ID=
WAFFO_PRODUCT_ID=
WAFFO_PRIVATE_KEY_FILE=
WAFFO_PRIVATE_KEY=
# Legacy generic key is ignored for live modes; configure the selected mode only.
WAFFO_WEBHOOK_TEST_PUBLIC_KEY=
WAFFO_WEBHOOK_PROD_PUBLIC_KEY=
WAFFO_API_BASE=https://api.waffo.ai
WAFFO_TIMEOUT_MS=10000
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_PATH=./data/playlist-headline.sqlite
